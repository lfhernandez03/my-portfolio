---
import Layout from "../layouts/Layout.astro";
import Tech from "../components/Tech.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import Header from "../components/Header.astro";
import Form from "../components/ReactComponents/Form";

const emailJsConfig = {
  serviceId: import.meta.env.EMAILJS_SERVICE_ID,
  templateId: import.meta.env.EMAILJS_TEMPLATE_ID,
  userId: import.meta.env.EMAILJS_USER_ID,
};
---

<Layout>
  <main class="max-w-screen-xl mx-auto p-5 px-8 sm:px-12 md:px-20 lg:px-28">
    <Header />
    <section
      id="inicio"
      class="first-sec mb-10 pb-5 section-transition section-transition-active"
    >
      <h1
        class="text-5xl sm:text-5xl md:text-7xl lg:text-8xl font-extrabold"
        style="letter-spacing: -0.12em;"
      >
        <span class="animate-fade">H</span>
        <span class="animate-fade" style="animation-delay: 1.0s;">o</span>
        <span class="animate-fade" style="animation-delay: 2.0s;">l</span>
        <span class="animate-fade" style="animation-delay: 3.0s;">a</span>
        <span class="animate-fade" style="animation-delay: 4.0s;">!</span>
      </h1>
      <h1 class="flex flex-col text-3xl font-bold">
        <span> Soy Luis Hernández </span>
        <span class="subhead">Desarrollador Web</span>
      </h1>
      <h2 class="flex flex-col items-center mt-8">
        <span class="text text-[14px] justify-center sm:w-96">
          ¡Bienvenido a mi portfolio! 👨‍💻 Soy Ingeniero de Sistemas (Universidad
          del Valle) y Desarrollador Full Stack. Trabajo cómodo tanto en
          frontend (React, Next.js, TypeScript) como en backend (Java, Spring
          Boot), y disfruto cada parte del proceso de construir software, desde
          la interfaz hasta la infraestructura.
        </span>
        <span class="flex space-x-4 items-center mt-5">
          <p>lfhernandez.cv@gmail.com</p>
          <a
            href="https://www.linkedin.com/in/lfhernandezsolis/"
            target="_blank"
          >
            <img
              class="w-12 h-12"
              src="images/linkedin.png"
              alt="imagen con link hacia perfil de linkedin"
            />
          </a>
          <a href="https://github.com/lfhernandez03"
            ><img
              class="w-12 h-12"
              src="images/github.png"
              alt="imagen con link hacia perfil de github"
            /></a
          >
        </span>
        <div class="my-5">
          <span class="flex items-center space-x-10">
            <i class="fa-solid fa-arrow-right"></i>
            <div class="flex flex-col items-center">
              <a href="\CV_LFHS_EN.pdf" target="_blank" class="text-sm"
                >Ver CV
              </a>
              <span class="border-2 w-full rounded-full"></span>
            </div>
            <i class="fa-solid fa-arrow-left"></i>
          </span>
        </div>
      </h2>
    </section>
    <section class="section-transition mb-10 pb-10">
      <h2 class="text-3xl font-bold">
        <span>Tecnologías</span>
        <div class="w-64 border-2 mt-1"></div>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 pt-10 space-y-5">
        <!-- Lenguajes -->
        <div class="flex flex-col items-center">
          <span class="text-2xl font-bold my-4">Lenguajes</span>
          <div class="grid grid-cols-2 gap-4 items-center justify-center">
            <Tech Src="images/html.png" Alt="HTML" Name="HTML5" />
            <Tech Src="images/css.png" Alt="CSS" Name="CSS3" />
            <Tech Src="images/js.png" Alt="JavaScript" Name="JavaScript" />
            <Tech
              Src="images/TypeScript.png"
              Alt="TypeScript"
              Name="TypeScript"
            />
            <Tech Src="images/Python.png" Alt="Python" Name="Python" />
            <Tech Src="images/java.png" Alt="Java" Name="Java" />
          </div>
        </div>
        <!-- Frameworks y Librerías -->
        <div class="flex flex-col items-center">
          <span class="text-2xl font-bold my-4">Frameworks y Librerías</span>
          <div class="grid grid-cols-2 gap-4">
            <Tech Src="images/React.png" Alt="React" Name="React" />
            <Tech Src="images/Astro.png" Alt="Astro" Name="Astro" />
            <Tech Src="images/Node.js.png" Alt="NodeJS" Name="NodeJS" />
            <Tech
              Src="images/TailwindCSS.png"
              Alt="TailwindCSS"
              Name="TailwindCSS"
            />
            <Tech Src="images/spring-boot.png" Alt="Spring" Name="Spring" />
            <Tech Src="images/nextjs.png" Alt="Next.js" Name="Next.js" />
          </div>
        </div>
        <!-- Herramientas -->
        <div class="flex flex-col items-center md:col-span-2">
          <span class="text-2xl font-bold my-4">Herramientas</span>
          <div class="grid grid-cols-2 gap-4">
            <Tech Src="images/git.png" Alt="Git" Name="Git" />
            <Tech Src="images/figma.png" Alt="Figma" Name="Figma" />
            <Tech Src="images/Jira.png" Alt="Jira" Name="Jira" />
            <Tech
              Src="images/AzureDevops.png"
              Alt="Azure DevOps"
              Name="Azure DevOps"
            />
            <Tech Src="images/docker.png" Alt="Docker" Name="Docker" />
          </div>
        </div>
      </div>
    </section>
    <section class="section-transition mb-10 pb-10">
      <h2 class="text-3xl font-bold">
        <span>Proyectos</span>
        <div class="w-64 border-2 mt-1"></div>
      </h2>
      <div class="flex flex-col pt-12">
        <Projects />
      </div>
    </section>
    <section class="section-transition mb-10 pb-10">
      <h2 class="text-3xl font-bold pt-10">
        <span>Sobre Mí</span>
        <div class="w-64 border-2 mt-1"></div>
      </h2>
      <div
        class="text text-[15px] leading-relaxed max-w-3xl mx-auto mt-10 grid gap-10 md:grid-cols-2"
      >
        <article class="space-y-4">
          <h3 class="text-lg font-bold">Mi enfoque</h3>
          <p>
            Lo que más disfruto de desarrollar software es el momento en que una
            idea abstracta se convierte en algo que alguien más puede usar. Esa
            curiosidad me llevó a explorar terrenos poco convencionales para un
            desarrollador full stack: mi trabajo de grado,
            <span class="font-semibold">MOVIQ</span>, combina ontologías,
            GraphRAG y modelos de lenguaje para construir un sistema de
            recomendación de películas que entiende el contexto del usuario.
          </p>
          <p>
            Soy detallista, me gusta hacer las cosas bien hechas y no dejo de
            aprender.
          </p>
        </article>
        <article class="space-y-4">
          <h3 class="text-lg font-bold">Fuera del código</h3>
          <p>
            Me muevo con soltura en español e inglés, y ahora sumo el alemán a
            la lista. Aprender un idioma nuevo me recuerda lo que se siente ser
            principiante, algo que valoro también al programar.
          </p>
          <p>
            El resto de mi tiempo lo reparto entre el deporte, el cine y la
            música: tres formas distintas de desconectar y volver con ideas
            frescas.
          </p>
        </article>
      </div>
    </section>
    <section id="contact" class="section-transition mb-10 pb-10">
      <h2 class="text-3xl font-bold pt-10">
        <span>Contacto</span>
        <div class="w-64 border-2 mt-1"></div>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 pt-10 justify-center">
        <section>
          <h3 class="flex items-center justify-center pt-10 pb-4">
            <span class="text-2xl font-bold">Enlaces</span>
          </h3>
          <div class="flex pt-10 w-full justify-center">
            <div class="flex flex-col space-y-4">
              <Contact
                title="Correo Electrónico"
                text="lfhernandez.cv@gmail.com"
                src="images/gmail.png"
                href="https://mail.google.com/mail/u/0/#inbox?compose=GTvVlcSBmlkCnkFgLpHXqpLSFBWDCLJzlmdgzMbZLFtVqxhzMDJCdDwZnDtQPJHmGstqJFxbZJJvX"
              />
              <Contact
                title="LinkedIn"
                text="Luis Hernández"
                src="images/linkedin.png"
                href="https://www.linkedin.com/in/lfhernandezsolis/"
              />
              <Contact
                title="GitHub"
                text="Luis Hernández"
                src="images/github.png"
                href="https://github.com/lfhernandez03"
              />
            </div>
          </div>
        </section>
        <section>
          <h3 class="flex items-center justify-center pt-10 pb-4">
            <span class="text-2xl font-bold"> Formulario de Contacto </span>
          </h3>
          <Form client:load {...emailJsConfig} />
        </section>
      </div>
    </section>
    <footer class="flex justify-between items-center mt-10">
      <p class="text-center">&copy; 2026 Luis Hernández.</p>
      <a href="#inicio">Volver al Inicio</a>
    </footer>
  </main>
  <style>
    @keyframes fadeInOut {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0;
      }
    }

    .animate-fade {
      animation: fadeInOut 10s infinite;
    }

    .first-sec {
      height: 100vh; /* Ocupa todo el viewport */
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .section-transition {
      opacity: 0;
      transition: opacity 0.5s ease-in-out;
    }

    .section-transition-active {
      opacity: 1;
    }
  </style>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const sections = document.querySelectorAll(".section-transition");
      console.log("Sections to observe:", sections);

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            console.log("Entry:", entry);
            if (entry.isIntersecting) {
              console.log("Intersecting:", entry.target);
              entry.target.classList.add("section-transition-active");
            } else {
              console.log("Not intersecting:", entry.target);
              entry.target.classList.remove("section-transition-active");
            }
          });
        },
        {
          threshold: 0.3, // Se activa cuando el 30% de la sección es visible
        },
      );

      sections.forEach((section) => {
        console.log("Observing section:", section);
        observer.observe(section);
      });
    });
  </script>
</Layout>
